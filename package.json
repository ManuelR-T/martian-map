{
  "name": "marps",
  "description": "Mars field-outing planner for Jezero. AI disclosure: code, tests and docs were written with AI coding assistants (Claude Code, Codex, Antigravity) and reviewed by the team; terrain annotation texts were drafted with AI; no scientific data or image is AI-generated.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24.14.0 <25",
    "pnpm": "9.15.4"
  },
  "scripts": {
    "dev": "pnpm --filter @marps/web dev",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "data:prepare": "uv run --locked --directory tools/data python -m marps_data.prepare",
    "data:check": "uv run --locked --directory tools/data python -m marps_data.check",
    "data:test": "uv run --locked --directory tools/data pytest"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.4",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.0.18"
  }
}
